{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms-endeavour.invalid/schemas/runtime-result.schema.json",
  "title": "HMS Runtime Result v1",
  "type": "object",
  "required": ["schema", "job_id", "operation", "status", "visibility", "evidence_label", "output", "limitations", "result_sha256"],
  "properties": {
    "schema": {"const": "HMS_RUNTIME_RESULT_V1"},
    "job_id": {"type": "string", "pattern": "^JOB-[A-F0-9]{16}$"},
    "operation": {"enum": ["gp29.calculate", "corpus.report.validate"]},
    "status": {"const": "SUCCEEDED"},
    "visibility": {"enum": ["PRIVATE", "PROJECT", "GROUP", "HMS_REVIEW", "PUBLIC"]},
    "evidence_label": {"enum": ["CALCULATION_ONLY", "PROVENANCE_ONLY"]},
    "output": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
