{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms-endeavour.invalid/schemas/gp29-result.schema.json",
  "title": "HMS GP29 Result v1",
  "type": "object",
  "required": ["schema", "algorithm", "input_mode", "normalized_runes", "normalized_tokens", "entries", "rune_count", "L_sum", "L_sum_mod29", "R_sum", "R_sum_mod29", "prime_sum", "prime_sum_mod29", "N_sum", "N_sum_mod29", "Q_sum", "Q_sum_mod4", "gp_sum", "gp_sum_mod29", "result_sha256"],
  "properties": {
    "schema": {"const": "HMS_GP29_RESULT_V1"},
    "algorithm": {"const": "GP29_LR_PRIME_NQ_V1"},
    "input_mode": {"enum": ["runes", "latin", "tokens"]},
    "normalized_runes": {"type": "string", "minLength": 1},
    "normalized_tokens": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "rune", "sound", "prime", "L", "R", "N", "Q"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 28},
          "rune": {"type": "string", "minLength": 1, "maxLength": 1},
          "sound": {"type": "string", "minLength": 1},
          "prime": {"type": "integer", "minimum": 2, "maximum": 109},
          "L": {"type": "integer", "minimum": 0, "maximum": 28},
          "R": {"type": "integer", "minimum": 0, "maximum": 28},
          "N": {"type": "integer", "minimum": 0, "maximum": 28},
          "Q": {"type": "integer", "minimum": 0, "maximum": 3}
        },
        "additionalProperties": false
      }
    },
    "rune_count": {"type": "integer", "minimum": 1},
    "L_sum": {"type": "integer", "minimum": 0},
    "L_sum_mod29": {"type": "integer", "minimum": 0, "maximum": 28},
    "R_sum": {"type": "integer", "minimum": 0},
    "R_sum_mod29": {"type": "integer", "minimum": 0, "maximum": 28},
    "prime_sum": {"type": "integer", "minimum": 2},
    "prime_sum_mod29": {"type": "integer", "minimum": 0, "maximum": 28},
    "N_sum": {"type": "integer", "minimum": 0},
    "N_sum_mod29": {"type": "integer", "minimum": 0, "maximum": 28},
    "Q_sum": {"type": "integer", "minimum": 0},
    "Q_sum_mod4": {"type": "integer", "minimum": 0, "maximum": 3},
    "gp_sum": {"type": "integer", "minimum": 2},
    "gp_sum_mod29": {"type": "integer", "minimum": 0, "maximum": 28},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
