{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms-endeavour.invalid/schemas/environment-manifest.schema.json",
  "title": "HMS Deterministic Environment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "hms_version", "engine", "operating_system", "architecture", "dependencies", "encoding", "alphabet_mapping", "page_numbering", "corpus_manifest_id", "random_seed", "container_or_lock_hash"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^ENV-[0-9]{4,}$"},
    "hms_version": {"type": "string", "minLength": 1},
    "engine": {"type": "string", "minLength": 1},
    "operating_system": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["name", "version", "hash"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "hash": {"type": ["string", "null"]}}}},
    "encoding": {"type": "string", "minLength": 1},
    "alphabet_mapping": {"type": "string", "minLength": 1},
    "page_numbering": {"type": "string", "minLength": 1},
    "corpus_manifest_id": {"type": ["string", "null"]},
    "random_seed": {"type": ["integer", "string", "null"]},
    "container_or_lock_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
