{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms-endeavour.invalid/schemas/run-set.schema.json",
  "title": "HMS Curated Run Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "version", "classification", "publication_status", "purpose", "run_ids", "result_ids", "capsule_ids", "selection_notes", "release_notes"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^RSET-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "classification": {"const": "PUBLIC"},
    "publication_status": {"enum": ["STAGED", "PUBLISHED"]},
    "purpose": {"type": "string", "minLength": 1},
    "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-[0-9]{4,}$"}},
    "result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RES-[0-9]{4,}$"}},
    "capsule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-[0-9]{4,}$"}},
    "selection_notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "release_notes": {"type": "string", "minLength": 1}
  }
}
