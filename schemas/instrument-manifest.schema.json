{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms-endeavour.invalid/schemas/instrument-manifest.schema.json",
  "title": "HMS Instrument Contract Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_reviewed", "instruments"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "2.0.0"},
    "last_reviewed": {"type": "string", "format": "date"},
    "instruments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["instrument_id", "name", "purpose", "version", "status", "release_channel", "access_level", "product_class", "customer_ready", "delivery_modes", "released_delivery_modes", "supported_platforms", "input_contract", "output_contract", "authority_class", "evidence_scope", "capabilities", "offline_behavior", "network_behavior", "privacy_behavior", "test_vectors", "self_test", "ordinary_user_acceptance", "limitations", "release_gate", "human_approval", "download_page", "last_updated"],
        "properties": {
          "instrument_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]},
          "status": {"enum": ["PLANNED", "IN_DEVELOPMENT", "INTERNAL_TESTING", "RELEASE_CANDIDATE", "RELEASED", "DEPRECATED", "RETIRED"]}, "release_channel": {"enum": ["DEVELOPMENT", "EXPERIMENTAL", "BETA", "RC", "STABLE"]},
          "access_level": {"enum": ["OBSERVER", "PILGRIM", "NAVIGATOR", "CARTOGRAPHER", "ADMIRAL", "INTERNAL"]}, "product_class": {"enum": ["DEVELOPER_TOOL", "USER_INSTRUMENT", "PUZZLE_PACKAGE", "PLUGIN", "HOSTED_SERVICE"]}, "customer_ready": {"type": "boolean"},
          "delivery_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["WEB", "DESKTOP_INSTALLER", "DESKTOP_PORTABLE", "CLI_BINARY", "RUNTIME", "PLUGIN", "DEVELOPER_SOURCE"]}}, "released_delivery_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["WEB", "DESKTOP_INSTALLER", "DESKTOP_PORTABLE", "CLI_BINARY", "RUNTIME", "PLUGIN", "DEVELOPER_SOURCE"]}}, "supported_platforms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "input_contract": {"type": "string", "minLength": 1}, "output_contract": {"type": "string", "minLength": 1}, "authority_class": {"enum": ["REFERENCE", "CALCULATION", "PROVENANCE", "STRUCTURAL_ANALYSIS", "EXPERIMENTAL", "SOLVER", "VERIFICATION"]}, "evidence_scope": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "offline_behavior": {"type": "string", "minLength": 1}, "network_behavior": {"type": "string", "minLength": 1}, "privacy_behavior": {"type": "string", "minLength": 1},
          "test_vectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "self_test": {"type": "boolean"}, "ordinary_user_acceptance": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "release_gate": {"type": "string", "minLength": 1}, "human_approval": {"type": "string", "minLength": 1}, "download_page": {"type": ["string", "null"]}, "last_updated": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
