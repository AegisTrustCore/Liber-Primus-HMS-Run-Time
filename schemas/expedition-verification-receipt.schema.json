{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms-endeavour.invalid/schemas/expedition-verification-receipt.schema.json",
  "title": "HMS Expedition Service Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "expedition_id", "client_version", "accepted", "submission_sha256", "verified_at", "verification_authority", "server_verified", "solution_disclosed", "receipt_signature"],
  "properties": {
    "schema": {"const": "HMS_EXPEDITION_VERIFICATION_RECEIPT_V2"},
    "receipt_id": {"type": "string", "pattern": "^VRF-[A-F0-9]{16}$"},
    "expedition_id": {"type": "string", "pattern": "^XPD-[A-Z0-9-]+$"},
    "client_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "accepted": {"type": "boolean"},
    "submission_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "verification_authority": {"const": "HMS_EXPEDITION_SERVICE"},
    "server_verified": {"const": true},
    "solution_disclosed": {"const": false},
    "receipt_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
