{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hms-endeavour.invalid/schemas/run-package.schema.json",
  "title": "HMS Canonical Run Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "version", "classification", "publication_status", "evidence_class", "reproduction_status", "migration_confidence", "executed_at", "target", "experiment_id", "result_ids", "capsule_id", "run_set_ids", "method_family", "pipeline_id", "summary", "why_run", "inputs", "parameters", "pipeline", "output", "controls", "interpretation", "limitations", "provenance", "raw_artifacts", "chronicle_events", "finding_tags"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^RUN-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "classification": {"const": "PUBLIC"},
    "publication_status": {"const": "PUBLISHED"},
    "evidence_class": {"enum": ["VERIFIED", "KNOWN_CONTROL", "STRUCTURAL", "BOUNDED_NEGATIVE", "HYPOTHESIS", "RESEARCH_PATH", "CORRECTION", "RETRACTED"]},
    "reproduction_status": {"enum": ["NOT_ATTEMPTED", "PARTIAL", "REPRODUCED", "FAILED_REPRODUCTION", "HISTORICAL_ONLY"]},
    "migration_confidence": {"enum": ["COMPLETE", "HIGH", "PARTIAL", "LOW"]},
    "executed_at": {"type": ["string", "null"]},
    "target": {"type": "object"},
    "experiment_id": {"type": ["string", "null"]},
    "result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RES-[0-9]{4,}$"}},
    "capsule_id": {"type": ["string", "null"], "pattern": "^CAP-[0-9]{4,}$"},
    "run_set_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RSET-[0-9]{4,}$"}},
    "method_family": {"type": "string", "minLength": 1},
    "pipeline_id": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 1},
    "why_run": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "parameters": {"type": "object"},
    "pipeline": {"type": "object"},
    "output": {"type": "object"},
    "controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "interpretation": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "raw_artifacts": {"type": "object"},
    "chronicle_events": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "finding_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
